<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Order Approver"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Orders stopped on the family phone wait here for your decision."
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <!-- Real not-connected state: shown only when this build has no Firebase config. -->
        <LinearLayout
            android:id="@+id/notConnectedCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/paper_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Not connected to a guardian phone yet"
                android:textColor="@color/warn_amber"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="This app receives requests through the family's free Firebase project. Until that is set up (SETUP_FIREBASE.md in the project folder) and both apps are reinstalled with the project file, no requests can arrive here — this screen is the honest state, not an error."
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="No requests yet."
            android:textColor="@color/ink_soft"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/requestsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Refresh"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
