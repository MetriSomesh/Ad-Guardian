<?xml version="1.0" encoding="utf-8"?>
<!-- Scoped to the monitored packages only (MonitoredPackages in :shared):
     the service is not woken for any other app on the phone. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_summary"
    android:notificationTimeout="100"
    android:packageNames="in.amazon.mShop.android.shopping,com.amazon.mShop.android.shopping,com.flipkart.android,com.google.android.youtube,com.instagram.android,com.facebook.katana,com.facebook.lite,com.whatsapp,com.android.chrome,com.google.android.apps.chrome,com.android.browser,com.sec.android.app.sbrowser,org.mozilla.firefox,com.microsoft.emmx,com.opera.browser,com.brave.browser,com.duckduckgo.mobile.android,com.vivo.browser,com.heytap.browser,com.mi.globalbrowser" />
